{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.astera.org/schema/hdx_entry/0.2.0",
  "title": "HDX entry (draft 0.2.0)",
  "description": "One experimental context: an HDX measurement (mHDX-MS or HDX-NMR) or a reference structure. Field names follow the Dynamic PDB schema v0.2.0 (2026-10-16) where an equivalent exists; HDX-specific additions are listed per record in `extensions`. Absent values are null or omitted, never zero.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "state",
    "revision",
    "title",
    "method",
    "polymer_entities",
    "artifacts",
    "runs",
    "models",
    "view",
    "extensions"
  ],
  "$defs": {
    "selector": {
      "type": "object",
      "description": "Extension: the fields and rows of a shared multi-row file that a link refers to.",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "key",
        "value",
        "software_name"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "software_name": {
          "type": "string"
        },
        "software_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_field": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^hdx_[0-9a-z]{8}$"
    },
    "kind": {
      "enum": [
        "hdx",
        "structure"
      ]
    },
    "state": {
      "enum": [
        "new",
        "active",
        "deleted"
      ]
    },
    "revision": {
      "type": "object",
      "required": [
        "revision_number",
        "parent_revision_id",
        "state"
      ],
      "properties": {
        "revision_number": {
          "type": "integer",
          "minimum": 1
        },
        "parent_revision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "in_review",
            "active",
            "rejected",
            "archived"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "change_summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "title": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "method_source": {
      "type": "string"
    },
    "polymer_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "sequence",
          "source_organisms",
          "mutations",
          "uniprot_mappings"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "construct": {
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "type": "string"
          },
          "source_organisms": {
            "type": "array"
          },
          "mutations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uniprot_mappings": {
            "type": "array"
          }
        }
      }
    },
    "hdx": {
      "type": "object",
      "description": "Extension: HDX experimental block, one record per sample (construct, replicate, labeling conditions), modeled on crystallography.crystals[].",
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "polymer_entity",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "polymer_entity": {
                "type": "string"
              },
              "measurement": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "index of the measurement within its construct, or 'mean'"
              },
              "mean_of_rows": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "source rows a mean averages, identified by recomputation"
              },
              "mean_check_max_abs_error": {
                "type": "number"
              },
              "conditions_differ": {
                "type": "boolean",
                "description": "the averaged measurements differ in pH, temperature or buffer"
              },
              "library": {
                "type": "string"
              },
              "pH": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "pH_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "merged_pH_series": {
                "type": "boolean"
              },
              "temperature_kelvin": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "buffer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "labeling_times_s": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "source": {
                "type": "object",
                "required": [
                  "artifact",
                  "rows"
                ]
              }
            }
          }
        },
        "peptide_map": {
          "type": "object",
          "description": "Extension: peptide count and coverage, with the identification run (L1a)."
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "level",
          "type",
          "uri",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "enum": [
              "L0",
              "L1",
              "L2",
              "L3"
            ]
          },
          "type": {
            "enum": [
              "model",
              "structure_factors",
              "fasta",
              "other"
            ]
          },
          "format": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "type": "string"
          },
          "stored": {
            "type": "boolean"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "software_name",
          "software_version",
          "inputs",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "software_name": {
            "type": "string"
          },
          "software_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": [
              "object",
              "null"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact": {
                  "type": "string"
                },
                "selector": {
                  "$ref": "#/$defs/selector"
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "artifact": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "selector": {
                  "$ref": "#/$defs/selector"
                }
              }
            }
          }
        }
      }
    },
    "undeclared_inputs": {
      "type": "array",
      "description": "Extension: sources a model depends on that cannot be registered as artifacts because no URI is known.",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision_number",
          "title",
          "model_type",
          "purpose",
          "model_source",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^hdx_[0-9a-z]{8}_m_[0-9]{3,}$"
          },
          "revision_number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "model_type": {
            "enum": [
              "Single Conformer",
              "Multiconformer",
              "Ensemble",
              "Deposited",
              "HDX ΔG set",
              "HDX differential set"
            ],
            "description": "'HDX ΔG set' and 'HDX differential set' are extensions: L2 interpretations without coordinates."
          },
          "purpose": {
            "enum": [
              "Model Building",
              "Refinement",
              "Reference"
            ]
          },
          "model_source": {
            "enum": [
              "pdb",
              "ext"
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run": {
            "type": "string"
          },
          "primary_artifact": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "string"
              },
              "selector": {
                "$ref": "#/$defs/selector"
              }
            }
          },
          "residue_frame": {
            "type": "object",
            "description": "Extension: the reference model whose label_* numbering the residue data use.",
            "required": [
              "entry",
              "model",
              "mapping"
            ]
          },
          "residue_data": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "required": [
                "label_asym_id",
                "label_seq_id",
                "label_comp_id"
              ],
              "properties": {
                "sample": {
                  "type": "string"
                },
                "label_asym_id": {
                  "type": "string"
                },
                "label_seq_id": {
                  "type": "integer"
                },
                "label_comp_id": {
                  "type": "string"
                },
                "auth_asym_id": {
                  "type": "string"
                },
                "auth_seq_id": {
                  "type": "integer"
                },
                "pdbx_pdb_ins_code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "dg": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "kobs": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "kint": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "logpf": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "too_slow": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "site_data": {
            "type": "object",
            "description": "Extension: values for sites not assigned to residues."
          },
          "ensemble_members": {
            "type": "integer"
          },
          "atom_count": {
            "type": "integer"
          },
          "modeled_residues": {
            "type": "integer"
          },
          "unique_protein_chains": {
            "type": "integer"
          },
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/metric"
            }
          }
        }
      }
    },
    "external_refs": {
      "type": "object"
    },
    "view": {
      "type": "string",
      "pattern": "^view_[0-9a-z]+$"
    },
    "linked_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entry",
          "basis"
        ],
        "properties": {
          "entry": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fields or values not defined in Dynamic PDB v0.2.0."
    },
    "citation": {
      "type": "string"
    },
    "ligands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CCD identifiers in the sample or deposited model"
    }
  }
}
