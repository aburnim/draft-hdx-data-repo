{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prism.astera.org/schema/hdx_entry/0.0.1",
  "title": "HDX entry (rough draft)",
  "description": "One protein construct measured by hydrogen-deuterium exchange, with every interpretation of that measurement as a peer. Draft 0.0.1: open to additions, nothing here is final. Absent values are null or omitted, never zero.",
  "type": "object",
  "required": ["schema_version", "id", "name", "protein", "external_refs", "artifacts", "runs", "interpretations"],
  "properties": {
    "schema_version": { "const": "0.0.1" },
    "id": { "type": "string", "pattern": "^hdx_[0-9a-z]{8}$" },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "protein": {
      "type": "object",
      "required": ["name", "origin"],
      "properties": {
        "name": { "type": "string" },
        "origin": { "enum": ["de novo design", "design variant", "natural domain", "PDB-derived domain"] },
        "topology": { "type": ["string", "null"] },
        "uniprot": { "type": ["string", "null"] }
      }
    },
    "chain": {
      "type": "object",
      "required": ["id", "positions"],
      "properties": {
        "id": { "type": "string" },
        "entity_description": { "type": ["string", "null"] },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pos", "compId", "letter", "seq"],
            "properties": {
              "pos": { "type": "integer", "minimum": 1 },
              "compId": { "type": "string" },
              "letter": { "type": "string", "maxLength": 1 },
              "seq": { "type": "integer", "description": "auth_seq_id" }
            }
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end", "kind"],
            "properties": {
              "start": { "type": "integer" },
              "end": { "type": "integer" },
              "kind": { "enum": ["helix", "strand"] }
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "method"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "method": { "enum": ["HDX-NMR", "mHDX-MS"] },
          "construct": { "type": ["string", "null"] },
          "replicate": { "type": ["integer", "string", "null"] },
          "pH": { "type": ["number", "string", "null"] },
          "temp_K": { "type": ["number", "null"] },
          "buffer": { "type": ["string", "null"] }
        }
      }
    },
    "external_refs": {
      "type": "object",
      "properties": {
        "pdb": { "type": ["string", "null"] },
        "pride": { "type": ["string", "null"], "pattern": "^PXD[0-9]{6}$" },
        "zenodo": { "type": ["string", "null"] },
        "doi": { "type": ["string", "null"] },
        "github": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "title", "format", "uri", "license", "held"],
        "properties": {
          "id": { "type": "string" },
          "short": { "type": "string", "description": "short display name" },
          "level": { "enum": ["L0", "L1", "L2", "L3"] },
          "title": { "type": "string" },
          "format": { "type": "string" },
          "uri": { "type": ["string", "null"], "description": "null when the source exists but its location is not known" },
          "fields": { "type": "array", "items": { "type": "string" }, "description": "the fields of a multi-level file this artifact covers" },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "license": { "type": "string" },
          "held": { "type": "boolean", "description": "true when this registry stores the bytes; false when it only references them" }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "software", "inputs", "outputs"],
        "properties": {
          "id": { "type": "string" },
          "software": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "parsed_from": { "type": "string" }
        }
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "method", "resolution", "artifact", "run"],
        "properties": {
          "id": { "type": "string", "pattern": "^m_[0-9]{3}$" },
          "title": { "type": "string" },
          "method": { "type": "string" },
          "resolution": { "enum": ["residue", "whole protein (unassigned)", "atomic model"] },
          "artifact": { "type": "string" },
          "run": { "type": ["string", "null"] },
          "conditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tracks": {
      "type": "object",
      "description": "Per-residue values in hetstar's Track JSON shape, keyed on auth numbering.",
      "additionalProperties": {
        "type": "object",
        "required": ["metricId", "level", "domain", "keys", "values"],
        "properties": {
          "metricId": { "type": "string" },
          "level": { "const": "residue" },
          "unit": { "type": "string" },
          "domain": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "keys": { "type": "array" },
          "values": { "type": "array", "items": { "type": ["number", "null"] } }
        }
      }
    },
    "derivations": {
      "type": "array",
      "description": "Where each displayed value or plot comes from, and how to check it.",
      "items": {
        "type": "object",
        "required": ["id", "label", "tier", "inputs", "runs", "raw"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "tier": { "enum": ["copied", "computed"], "description": "copied: verbatim from an archived file; computed: derived by this repository from archived files" },
          "value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["artifact", "fields", "rows"],
              "properties": {
                "artifact": { "type": "string" },
                "fields": { "type": "array", "items": { "type": "string" } },
                "rows": { "type": "array", "items": { "type": ["string", "null"] } }
              }
            }
          },
          "runs": { "type": "array", "items": { "type": "string" }, "description": "upstream run chain, raw data first" },
          "raw": { "enum": ["pipelines", "blocked", "deposited"], "description": "regeneration from raw data: needs the upstream pipelines, is blocked because a raw input was not found (displayed as \"raw input not found\"), or does not apply (deposited file)" },
          "operation": { "type": ["string", "null"] },
          "code": { "type": ["string", "null"] },
          "check": { "type": ["string", "null"] }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value", "level", "interpretation"],
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": ["string", "null"] },
          "level": { "enum": ["L2", "L3"] },
          "interpretation": { "type": "string" },
          "source_field": { "type": "string" },
          "computed_here": { "type": "boolean" }
        }
      }
    }
  }
}
